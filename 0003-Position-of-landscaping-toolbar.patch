+static void ViewportDrawTileSprites(const TileSpriteToDrawVector *tstdv)
+{
+	const TileSpriteToDraw *tsend = tstdv->End();
+	for (const TileSpriteToDraw *ts = tstdv->Begin(); ts != tsend; ++ts) {
