+static WindowDesc _tool_tips_desc(
+	WDP_MANUAL, NULL, 0, 0, // Coordinates and sizes are not used,
+	WC_TOOLTIPS, WC_NONE,
+	0,
+	_nested_tooltips_widgets, lengthof(_nested_tooltips_widgets)
+);
