+static Point MapXYZToViewport(const ViewPort *vp, int x, int y, int z)
+{
+	Point p = RemapCoords(x, y, z);
+	p.x -= vp->virtual_width / 2;
+	p.y -= vp->virtual_height / 2;
+	return p;
