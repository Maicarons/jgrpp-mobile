+	/* Wagon weight - (including cargo) */
+	uint weight = e->GetDisplayWeight();
+	SetDParam(0, weight);
+	uint cargo_weight = (e->CanCarryCargo() ? CargoSpec::Get(e->GetDefaultCargoType())->weight * GetTotalCapacityOfArticulatedParts(engine_number) / 16 : 0);
