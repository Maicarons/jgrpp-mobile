+/**
+ * Close down the windowing system
+ */
+void UnInitWindowSystem()
+{
+	UnshowCriticalError();
+
+	Window *w;
+	FOR_ALL_WINDOWS_FROM_FRONT(w) delete w;
+
+	for (w = _z_front_window; w != NULL; /* nothing */) {
+		Window *to_del = w;
+		w = w->z_back;
