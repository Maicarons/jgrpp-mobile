+/**
+ * Start a drag for demolishing an area.
+ * @param tile Position of one corner.
+ */
+void PlaceProc_DemolishArea(TileIndex tile)
+{
+	VpStartPlaceSizing(tile, VPM_X_AND_Y, DDSP_DEMOLISH_AREA);
+}
