+/** Cargo suffix type (for which window is it requested) */
+enum CargoSuffixType {
+	CST_FUND,  ///< Fund-industry window
+	CST_VIEW,  ///< View-industry window
+	CST_DIR,   ///< Industry-directory window
+};
