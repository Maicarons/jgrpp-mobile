+				if (counter == 0) unsetenv("SDL_RESTART_PARAMS");
+			}
 			break;
 
 		case GM_NORMAL:
diff --git a/src/openttd.cpp b/src/openttd.cpp
index ca4f58f815..f106f09d92 100644
