diff --git a/src/window.cpp b/src/window.cpp
index 233e758ef0..fca479ce26 100644
--- a/src/window.cpp
+++ b/src/window.cpp
@@ -1295,7 +1295,6 @@ static uint GetWindowZPriority(const Window *w)
 
 		case WC_MAIN_TOOLBAR:
 		case WC_MAIN_TOOLBAR_RIGHT:
