 			++z_priority;
 
 		case WC_OSK:
@@ -1326,10 +1325,13 @@ static uint GetWindowZPriority(const Window *w)
 		case WC_CONSOLE:
 			++z_priority;
 
-		case WC_NEWS_WINDOW:
