 3 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/src/rail_gui.cpp b/src/rail_gui.cpp
index f2c9d5636f..a5bb3fbd12 100644
--- a/src/rail_gui.cpp
+++ b/src/rail_gui.cpp
@@ -409,7 +409,7 @@ struct BuildRailToolbarWindow : Window {
 		this->last_user_action = WIDGET_LIST_END;
 		this->last_user_action_remove = false;
 
-		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar(this);
+		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar(NULL);
 	}
 
 	~BuildRailToolbarWindow()
diff --git a/src/road_gui.cpp b/src/road_gui.cpp
index 1da4b47f88..4d9f03062e 100644
--- a/src/road_gui.cpp
+++ b/src/road_gui.cpp
@@ -315,7 +315,7 @@ struct BuildRoadToolbarWindow : Window {
