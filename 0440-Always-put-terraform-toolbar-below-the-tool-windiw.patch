From 1770e24fc5175defa9e0b58f08dacece19754053 Mon Sep 17 00:00:00 2001
From: Sergii Pylypenko <x.pelya.x@gmail.com>
Date: Mon, 25 Sep 2017 21:55:45 +0300
Subject: [PATCH 0440/1053] Always put terraform toolbar below the tool windiw

---
 src/airport_gui.cpp | 2 +-
 src/dock_gui.cpp    | 2 +-
 src/rail_gui.cpp    | 2 +-
 src/road_gui.cpp    | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/airport_gui.cpp b/src/airport_gui.cpp
index ff4522e81f..03a9f14852 100644
--- a/src/airport_gui.cpp
+++ b/src/airport_gui.cpp
@@ -75,7 +75,7 @@ struct BuildAirToolbarWindow : Window {
 	BuildAirToolbarWindow(WindowDesc *desc, WindowNumber window_number) : Window(desc)
 	{
 		this->InitNested(window_number);
-		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar(this);
+		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar();
 		this->last_user_action = WIDGET_LIST_END;
 	}
 
diff --git a/src/dock_gui.cpp b/src/dock_gui.cpp
index c82d2dd03c..c3a5025332 100644
--- a/src/dock_gui.cpp
+++ b/src/dock_gui.cpp
@@ -101,7 +101,7 @@ struct BuildDocksToolbarWindow : Window {
 		this->last_clicked_widget = WID_DT_INVALID;
 		this->InitNested(window_number);
 		this->OnInvalidateData();
-		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar(this);
+		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar();
 	}
 
 	~BuildDocksToolbarWindow()
diff --git a/src/rail_gui.cpp b/src/rail_gui.cpp
index a5bb3fbd12..a822128f0a 100644
--- a/src/rail_gui.cpp
+++ b/src/rail_gui.cpp
@@ -409,7 +409,7 @@ struct BuildRailToolbarWindow : Window {
 		this->last_user_action = WIDGET_LIST_END;
 		this->last_user_action_remove = false;
 
-		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar(NULL);
+		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar();
 	}
 
 	~BuildRailToolbarWindow()
diff --git a/src/road_gui.cpp b/src/road_gui.cpp
index 4d9f03062e..0b696ce8ca 100644
--- a/src/road_gui.cpp
+++ b/src/road_gui.cpp
@@ -315,7 +315,7 @@ struct BuildRoadToolbarWindow : Window {
 		this->last_started_action_remove = false;
 		this->last_started_action_oneway = false;
 
-		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar(NULL);
+		if (_settings_client.gui.link_terraform_toolbar || _settings_client.gui.compact_vertical_toolbar) ShowTerraformToolbar();
 	}
 
 	~BuildRoadToolbarWindow()
-- 
2.55.0

