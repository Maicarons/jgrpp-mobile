 4 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/blitter/16bpp_anim.cpp b/src/blitter/16bpp_anim.cpp
index 115ffe9df5..f5a51cfb60 100644
--- a/src/blitter/16bpp_anim.cpp
+++ b/src/blitter/16bpp_anim.cpp
