From: =?UTF-8?q?Lo=C3=AFc=20Guilloux?= <glx22@users.noreply.github.com>
Date: Wed, 20 Oct 2021 22:14:23 +0200
Subject: [PATCH 0620/1053] Change: Don't store not to be activated newGRFs in
 savegames (#9627)

---
 src/saveload/newgrf_sl.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/saveload/newgrf_sl.cpp b/src/saveload/newgrf_sl.cpp
index 510ffc156e..5dde97132c 100644
--- a/src/saveload/newgrf_sl.cpp
+++ b/src/saveload/newgrf_sl.cpp
@@ -81,7 +81,7 @@ struct NGRFChunkHandler : ChunkHandler {
 		int index = 0;
 
 		for (GRFConfig *c = _grfconfig; c != nullptr; c = c->next) {
-			if (HasBit(c->flags, GCF_STATIC)) continue;
+			if (HasBit(c->flags, GCF_STATIC) || HasBit(c->flags, GCF_INIT_ONLY)) continue;
 			SlSetArrayIndex(index++);
 			SlObject(c, _grfconfig_desc);
 		}
