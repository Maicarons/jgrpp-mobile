+		int y = r.top;
 		/* Draw company list */
 		int pos = this->vscroll->GetPosition();
 		while (pos < this->server->info.companies_on) {
@@ -1573,7 +1575,7 @@ static const NWidgetPart _nested_network_lobby_window_widgets[] = {
 		NWidget(NWID_HORIZONTAL), SetPIP(10, 0, 10),
