 os/emscripten/emscripten-build.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/os/emscripten/emscripten-build.sh b/os/emscripten/emscripten-build.sh
index 67431aa0c5..c8f45aa1b2 100755
--- a/os/emscripten/emscripten-build.sh
+++ b/os/emscripten/emscripten-build.sh
@@ -53,7 +53,7 @@ mkdir -p baseset
 }
 
 [ -e TimGM6mb.sf2 ] || {
-	wget 'https://sourceforge.net/p/mscore/code/HEAD/tree/trunk/mscore/share/sound/TimGM6mb.sf2?format=raw' || exit 1
