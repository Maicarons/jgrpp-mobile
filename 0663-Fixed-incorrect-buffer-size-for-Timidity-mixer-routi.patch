From: Sergii Pylypenko <x.pelya.x@gmail.com>
Date: Tue, 4 May 2021 23:05:17 +0300
Subject: [PATCH 0663/1053] Fixed incorrect buffer size for Timidity mixer
 routine

---
 src/music/libtimidity.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/music/libtimidity.cpp b/src/music/libtimidity.cpp
index a137f43911..2c2795a188 100644
--- a/src/music/libtimidity.cpp
+++ b/src/music/libtimidity.cpp
@@ -44,7 +44,7 @@ static void MidiMixMusic(int16 *stream, size_t len)
 	std::unique_lock<std::mutex> lock{ _midi.synth_mutex, std::try_to_lock };
 
 	if (_midi.status == MIDI_PLAYING) {
-		mid_song_read_wave(_midi.song, (sint8 *)stream, len*2);
+		mid_song_read_wave(_midi.song, (sint8 *)stream, len * 4);
 	}
 }
 
