From: Sergii Pylypenko <x.pelya.x@gmail.com>
Date: Thu, 6 May 2021 00:12:08 +0300
Subject: [PATCH 0682/1053] Emscripten: disabled fullscreen mode, it apparently
 crashes in iOS 14.4

---
 src/video/sdl2_v.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/video/sdl2_v.cpp b/src/video/sdl2_v.cpp
index 6e9f7b40f8..0d20fb210b 100644
--- a/src/video/sdl2_v.cpp
+++ b/src/video/sdl2_v.cpp
@@ -436,7 +436,8 @@ bool VideoDriver_SDL_Base::PollEvent()
 #ifdef __EMSCRIPTEN__
 			if (_request_fullscreen) {
 				_request_fullscreen = false;
-				EM_ASM( document.documentElement.requestFullscreen(); );
+				// This apparently crashes the webapp on iPhone XS with iOS 14.4.2
+				// EM_ASM( document.documentElement.requestFullscreen(); );
 			}
 #endif
 			break;
