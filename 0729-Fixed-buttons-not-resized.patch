diff --git a/src/widget_type.h b/src/widget_type.h
index 5dc6b0d667..b918803ba5 100644
--- a/src/widget_type.h
+++ b/src/widget_type.h
@@ -267,6 +267,7 @@ public:
 	void SetMinimalSize(uint min_x, uint min_y);
 	void SetMinimalSizeAbsolute(uint min_x, uint min_y);
