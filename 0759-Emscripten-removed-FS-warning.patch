index 80987b2999..251f033ac7 100644
--- a/os/emscripten/pre.js
+++ b/os/emscripten/pre.js
@@ -59,13 +59,6 @@ Module.preRun.push(function() {
     window.openttd_syncfs = function() {
         /* Copy the virtual FS to the persistent storage. */
