From f1232bfed7c298c7c7b194e33c890121ed374ab1 Mon Sep 17 00:00:00 2001
From: Sergii Pylypenko <x.pelya.x@gmail.com>
Date: Tue, 22 Feb 2022 01:50:42 +0200
Subject: [PATCH 0802/1053] CI: OpenTTD will not link without libfreetype-dev
 package

---
 .github/workflows/ci-build.yml | 1 +
 os/emscripten/README.md        | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci-build.yml b/.github/workflows/ci-build.yml
index ec5d35e52c..5fb1b6842a 100644
--- a/.github/workflows/ci-build.yml
+++ b/.github/workflows/ci-build.yml
@@ -37,6 +37,7 @@ jobs:
           gperf \
           libharfbuzz-dev \
           libicu-dev \
+          libfreetype-dev \
           # EOF
         echo "::endgroup::"
 
diff --git a/os/emscripten/README.md b/os/emscripten/README.md
index 488fe92a72..0fff310dda 100644
--- a/os/emscripten/README.md
+++ b/os/emscripten/README.md
@@ -6,7 +6,7 @@ You will also need libharfbuzz-dev and libicu-dev installed on your host OS.
 
 
 ```
-  sudo apt-get install autoconf automake libtool gperf libharfbuzz-dev libicu-dev
+  sudo apt-get install autoconf automake libtool gperf libharfbuzz-dev libicu-dev libfreetype-dev
 
   ./emscripten-build.sh
 ```
-- 
2.55.0

