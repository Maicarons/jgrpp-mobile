+		_button_ratio_cfg = this->button_ratio;
 
 		if (AdjustGUIZoom(false)) {
 			ReInitAllWindows(true);
@@ -1084,35 +1100,36 @@ static constexpr NWidgetPart _nested_game_options_widgets[] = {
