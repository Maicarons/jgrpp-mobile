diff --git a/src/table/settings/misc_settings.ini b/src/table/settings/misc_settings.ini
index b0b5c91a94..7710fc9805 100644
--- a/src/table/settings/misc_settings.ini
+++ b/src/table/settings/misc_settings.ini
@@ -359,6 +359,15 @@ min      = -1
 max      = MAX_INTERFACE_SCALE
 cat      = SC_BASIC
 
+[SDTG_VAR]
+name     = ""button_ratio""
+type     = SLE_INT32
+var      = _button_ratio_cfg
+def      = 100
+min      = 100
+max      = MAX_INTERFACE_SCALE
+cat      = SC_BASIC
+
 [SDTG_BOOL]
 ifdef    = WITH_COCOA
 name     = ""allow_hidpi""
diff --git a/src/widget.cpp b/src/widget.cpp
index fcdb8eeb7b..1c07c28b58 100644
--- a/src/widget.cpp
+++ b/src/widget.cpp
@@ -3570,7 +3570,9 @@ std::unique_ptr<NWidgetBase> MakeCompanyButtonRows(WidgetID widget_first, Widget
  */
 uint32_t GetMinButtonSize(uint32_t min_1)
 {
-	uint32_t min_sizing = _gui_scale / 4;
+	if (_button_ratio_cfg == 0) _button_ratio_cfg = 25;
+
+	uint32_t min_sizing = 0.25 * _gui_scale + 0.25 * _button_ratio_cfg;
 
 	return std::max(min_sizing, min_1);
 }
