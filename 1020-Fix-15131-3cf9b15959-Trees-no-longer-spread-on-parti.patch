From 3d8826bd16d09b2fe6a0421b9674334e448ee67e Mon Sep 17 00:00:00 2001
From: Peter Nelson <peter1138@openttd.org>
Date: Mon, 19 Jan 2026 18:45:51 +0000
Subject: [PATCH 1020/1053] Fix #15131, 3cf9b15959: Trees no longer spread on
 partially snowy tiles. (#15133)

---
 src/tree_cmd.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/tree_cmd.cpp b/src/tree_cmd.cpp
index 1123177a04..f620799263 100644
--- a/src/tree_cmd.cpp
+++ b/src/tree_cmd.cpp
@@ -891,7 +891,7 @@ static void TileLoop_Trees(TileIndex tile)
 						if (!CanPlantTreesOnTile(tile, false)) return;
 
 						/* Don't plant trees, if ground was freshly cleared */
-						if (IsTileType(tile, MP_CLEAR) && GetClearGround(tile) == CLEAR_GRASS && GetClearDensity(tile) != 3) return;
+						if (IsTileType(tile, MP_CLEAR) && GetClearGround(tile) == CLEAR_GRASS && !IsSnowTile(tile) && GetClearDensity(tile) != 3) return;
 
 						PlantTreesOnTile(tile, treetype, 0, TreeGrowthStage::Growing1);
 
