From 4fd478295b4358f3a33e1d69e3cfdf45a4dac6d0 Mon Sep 17 00:00:00 2001
From: Peter Nelson <peter1138@openttd.org>
Date: Mon, 19 Jan 2026 19:59:57 +0000
Subject: [PATCH 1021/1053] Fix 595b696d61: Tile suitability test for farm
 field no longer handled snow tiles. (#15134)

---
 src/industry_cmd.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/industry_cmd.cpp b/src/industry_cmd.cpp
index 22bad9aad1..bdf2bfc546 100644
--- a/src/industry_cmd.cpp
+++ b/src/industry_cmd.cpp
@@ -1002,8 +1002,8 @@ static bool IsSuitableForFarmField(TileIndex tile, bool allow_fields, bool allow
 {
 	switch (GetTileType(tile)) {
 		case MP_CLEAR:
+			if (IsSnowTile(tile)) return false;
 			switch (GetClearGround(tile)) {
-				case CLEAR_SNOW: return false;
 				case CLEAR_DESERT: return false;
 				case CLEAR_ROUGH: return allow_rough;
 				case CLEAR_FIELDS: return allow_fields;
